# Docker Compose Environment Variables
# Copy this file to .env in the root directory for Docker Compose

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-secure-password
POSTGRES_DB=ecommerce

# JWT Secret (REQUIRED - must be changed for production)
JWT_SECRET=your-secure-random-jwt-secret-key-change-this

# Optional: Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Optional: Admin Credentials for Seed Script
ADMIN_EMAIL=admin@ecommerce.com
ADMIN_PASSWORD=admin123
